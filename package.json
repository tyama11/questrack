{
  "name": "questrack",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsrs --noEmit --fast && vite build",
    "build:desktop": "tsrs --noEmit --fast && vite build --mode desktop",
    "build:pages": "tsrs --noEmit --fast && vite build --mode pages",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "TSRS_FAST=1 oxlint --type-aware --deny-warnings .",
    "test": "vitest run"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-process": "~2.4.0",
    "@tauri-apps/plugin-shell": "~2.6.0",
    "@tauri-apps/plugin-updater": "~2.14.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "tsrs": "7.1.0-beta.tsrs5",
    "oxlint": "1.95.0"
  }
}
